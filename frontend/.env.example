# API base URL used by the API client. Defaults to "/api/v1/" so requests are
# served by Django in production and proxied to the dev server in development.
# For local development point this at the Django backend, e.g.:
#   VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1/
VITE_API_BASE_URL=/api/v1/
