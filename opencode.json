{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "odin": {
      "type": "local",
      "command": ["uv", "run", "python", "-m", "mcp_server.main"],
      "enabled": true
    },
    "Playwright": {
      "type": "local",
      "command": ["npx", "-y", "@tontoko/fast-playwright-mcp@0.1.3"],
      "enabled": true
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": ["uvx", "ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  }
}
