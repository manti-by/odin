{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "ODIN": {
        "type": "local",
        "command": ["uv", "run", "python", "-m", "mcp_server.main"],
        "environment": { "POSTGRES_HOST": "192.168.1.100" }
      },
      "WI": {
        "type": "local",
        "command": ["wi"]
      },
      "Playwright": {
        "type": "local",
        "command": ["npx", "-y", "@tontoko/fast-playwright-mcp@0.1.3"]
      }
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": ["uvx", "ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  }
}
