{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "ODIN": {
        "type": "remote",
        "url": "https://192.168.1.100/mcp",
        "oauth": false,
        "headers": { "Authorization": "Bearer {env:MCP_AUTH_TOKEN}" }
      },
      "WI": {
        "type": "local",
        "command": ["wi"]
      },
      "Playwright": {
        "type": "local",
        "command": ["npx", "-y", "@tontoko/fast-playwright-mcp@0.1.3"]
      }
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": ["uvx", "ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  }
}
